# Supabase project connection details.
# Copy this file to .env.local and fill in real values for local development.
# Never commit .env.local or any file containing real credentials.

# Public — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secret — server-only. Must NEVER be prefixed with NEXT_PUBLIC_ or referenced
# from client components/browser code.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical, fully-qualified URL this app is reachable at. Used to build the
# Slack OAuth redirect_uri (must exactly match the Redirect URL configured in
# the Slack app dashboard). Public — safe to expose to the browser.
#   Local:      http://localhost:3000
#   Production: https://your-app.vercel.app
NEXT_PUBLIC_APP_URL=

# Slack app credentials — from https://api.slack.com/apps > your app > Basic
# Information. All secret — server-only.
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
# Not used yet in M1. Reserved for verifying inbound Slack request signatures
# once M2 adds endpoints that receive them (events, interactions, slash
# commands).
SLACK_SIGNING_SECRET=

# Cryptographically random 32-byte key, base64-encoded, used to encrypt
# Slack bot tokens at rest (AES-256-GCM). Generate on macOS with:
#   openssl rand -base64 32
# Secret — server-only. Rotating this key invalidates every stored token.
SLACK_TOKEN_ENCRYPTION_KEY=

# Paddle billing (M10.2) — Sandbox only. Live is not configured anywhere in
# this app yet. From https://sandbox-vendors.paddle.com > Developer tools >
# Authentication. "sandbox" or "live" — must match which environment
# PADDLE_API_KEY and NEXT_PUBLIC_PADDLE_CLIENT_TOKEN below belong to (see
# src/lib/billing/paddle-environment-guard.ts, which fails loudly on a
# mismatch).
PADDLE_ENVIRONMENT=sandbox

# Secret — server-only. Sandbox key prefix: pdl_sdbx_apikey_; live: pdl_live_apikey_.
PADDLE_API_KEY=

# Public — safe to expose to the browser (Paddle.js). Sandbox token prefix:
# test_; live: live_. Never the same value as PADDLE_API_KEY.
NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=

# Server-only, not secret — the Paddle Price ID (pri_...) for ApproveGo
# Pro's monthly subscription. The browser never sees this; the checkout
# page only ever exposes a transactionId.
PADDLE_PRO_PRICE_ID=

# Secret — server-only (M10.3). Signs/verifies inbound webhook deliveries
# for the Paddle notification destination pointed at
# /api/paddle/webhooks. Not created yet — see the M10.3 README section.
# Never the same value as PADDLE_API_KEY.
PADDLE_WEBHOOK_SECRET=
